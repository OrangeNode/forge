# 各层级的环境文件可能含实际凭据；只提交无敏感值的示例。
.env
.env.*
!.env.example
# 后台管理前端的公共开发默认值可提交，覆盖文件仍保持忽略。
!frontend/admin/.env

# 私钥与密钥库
*.key
*.pem
*.p12
*.pfx
*.jks
*.keystore

# Java / Maven 构建产物
target/
*.class

# 应用运行日志与诊断文件
logs/
*.log
*.hprof
hs_err_pid*

# Node / 前端构建产物与测试报告
node_modules/
dist/
*.tsbuildinfo
.pnpm-store/
.vite/
.eslintcache
coverage/
test-results/
playwright-report/
# 用户提供的风格提案，只作设计基准，不进入版本管理
frontend/admin/design-showcase*.html

# 接口类型生成的中间产物：由 pnpm run generate:api-types 重新生成，只保留生成结果
frontend/packages/api-client/src/generated/*.openapi.json

# 受限执行环境的本地构建缓存：本地 Maven 仓库镜像、包装器目录与临时设置，不进入版本管理
.m2repo/
.maven-wrapper/
.mvn-local-settings.xml

# IDE 与操作系统
.idea/
.vscode/
*.iml
*.ipr
*.iws
.classpath
.project
.settings/
.DS_Store
Thumbs.db
Desktop.ini

# 编辑器临时文件
*.swp
*.swo
*~
