# 可提交的公共开发默认值；本机差异写入未提交的 .env.local。
VITE_API_BASE_URL=
VITE_APP_ENV=local
# 默认开发端口；占用时明确报错，通过 .env.local 调整。
VITE_DEV_PORT=5173
# 开发代理前缀与目标；部署地址变化无需修改代码。
VITE_API_PROXY_PREFIX=/api
VITE_API_PROXY_TARGET=http://127.0.0.1:8080

# 视频列表分页默认值、候选条数、记录刷新间隔与新增资源站的默认时区。
VITE_VIDEO_PAGE_SIZE=20
VITE_VIDEO_PAGE_SIZE_OPTIONS=10,20,50,100
VITE_VIDEO_REFRESH_MILLIS=5000
VITE_VIDEO_DEFAULT_ZONE=Asia/Shanghai

# 新建定时任务默认的五段 cron（分 时 日 月 周），调度时区由后端配置统一决定。
VITE_VIDEO_DEFAULT_CRON=0 2 * * *

# 文件上传（含 App 安装包）的超时毫秒数，普通请求仍用默认 15 秒。
VITE_UPLOAD_TIMEOUT_MILLIS=900000
