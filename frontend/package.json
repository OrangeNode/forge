{
  "name": "orange-forge-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev:admin": "pnpm --filter @orange-forge/admin dev",
    "build": "pnpm -r build",
    "type-check": "pnpm -r type-check",
    "lint": "eslint packages admin/src",
    "lint:fix": "eslint packages admin/src --fix",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.5.1",
    "@vue/eslint-config-typescript": "14.9.0",
    "eslint": "10.10.0",
    "eslint-plugin-vue": "10.11.0",
    "globals": "17.12.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0"
  }
}
