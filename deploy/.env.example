# 测试服务器部署环境变量模板：复制为同目录 .env，填入随机生成的值后 chmod 600。
# 真实值只保存在服务器上，不进入版本库、文档或日志。生成方式见 docs/部署指南.md。
COMPOSE_PROJECT_NAME=orange-forge
# 对外端口（nginx）；被占用时改为其他端口，并同步防火墙与 App 接口地址。
HTTP_PORT=80

MYSQL_DATABASE=orange_forge
MYSQL_USER=forge
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
REDIS_PASSWORD=

# 文件存储凭据加密主密钥：Base64 编码的 32 字节随机值。
FORGE_FILE_ENCRYPTION_KEY=
FORGE_REDIS_KEY_PREFIX=forge:server

# 初始管理员：只在管理员账号表为空时创建，首次登录后建议在后台修改口令。
FORGE_INIT_ADMIN_USERNAME=admin
FORGE_INIT_ADMIN_PASSWORD=

# 项目包日志级别；排查问题时可临时改为 DEBUG（会输出 SQL 参数）。
FORGE_LOG_LEVEL=INFO

# 后端 JVM 参数，按服务器内存调整。
JAVA_TOOL_OPTIONS=-Xms256m -Xmx768m
