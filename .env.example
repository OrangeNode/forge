# 从项目根目录复制为 .env.local 后填写密码；不要提交 .env.local。
COMPOSE_PROJECT_NAME=orange-forge

# 应用使用独立 MySQL 账号，不能将 MYSQL_USER 改为 root。
MYSQL_DATABASE=orange_forge
MYSQL_USER=forge
MYSQL_PORT=3306

# 必填且无默认密码；为空时 Compose 配置解析会失败。
# 填写后建议用单引号包裹，避免密码中的 $、# 被环境文件解析。
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

REDIS_PORT=6379
REDIS_PASSWORD=
