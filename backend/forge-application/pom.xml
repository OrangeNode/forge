<?xml version="1.0" encoding="UTF-8"?>
<!--
  forge-application：唯一可执行模块，负责模块装配、环境配置与启动入口。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cn.orangenode</groupId>
        <artifactId>forge-backend</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>forge-application</artifactId>
    <name>forge-application</name>
    <description>应用装配与启动入口</description>

    <dependencies>
        <dependency>
            <groupId>cn.orangenode</groupId>
            <artifactId>forge-framework</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.orangenode</groupId>
            <artifactId>forge-system</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.orangenode</groupId>
            <artifactId>forge-file</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.orangenode</groupId>
            <artifactId>forge-audit</artifactId>
        </dependency>
        <!-- 移除示例模块时删除下面这一项即可 -->
        <dependency>
            <groupId>cn.orangenode</groupId>
            <artifactId>forge-example</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>
        <!--
          本机以内存库演示启动时使用（profile 为 standalone），仅运行时需要，不参与测试编译；
          生产与联调环境仍使用 MySQL，见 application.yaml 的数据源约定。
        -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 架构约束检查：在可执行模块内做整体装配校验，业务模块不各自引入 -->
        <dependency>
            <groupId>com.puppycrawl.tools</groupId>
            <artifactId>checkstyle</artifactId>
            <version>${checkstyle.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>1.4.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <forge.backend.directory>${maven.multiModuleProjectDirectory}</forge.backend.directory>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>cn.orangenode.forge.ForgeApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
