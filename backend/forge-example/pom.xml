<?xml version="1.0" encoding="UTF-8"?>
<!--
  forge-example：可移除的最简示例模块，只提供 GET /hello，不建业务表。
  移除示例时同时删除本模块目录、父工程 modules 条目与 application 依赖。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cn.orangenode</groupId>
        <artifactId>forge-backend</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>forge-example</artifactId>
    <name>forge-example</name>
    <description>可移除的最简示例模块</description>

    <dependencies>
        <!-- 示例只依赖基础模块，Web、Validation 与统一协议能力由 framework 提供 -->
        <dependency>
            <groupId>cn.orangenode</groupId>
            <artifactId>forge-framework</artifactId>
        </dependency>
    </dependencies>
</project>
